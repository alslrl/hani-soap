# Local development requires only OPENAI_API_KEY for real model calls.
# Copy this file only if .env.local does not already exist. Never overwrite a key.
OPENAI_API_KEY=

# Optional locally; required for Vercel. Server-only, no NEXT_PUBLIC_ prefix.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=
# DEMO_PIN_HASH=scrypt$SALT$HASH
# APP_ORIGIN=https://YOUR_DEPLOYMENT.vercel.app

# Optional feature model overrides. Defaults preserve the selected models.
# OPENAI_MODEL_LIVE=gpt-live-transcribe
# OPENAI_MODEL_DIARIZATION=gpt-4o-transcribe-diarize
# OPENAI_MODEL_TEXT_TRANSCRIPTION=gpt-transcribe
# Legacy OPENAI_MODEL_TRANSCRIPTION remains a diarization-only alias.
# OPENAI_MODEL_CORRECTION=gpt-6.1-sol
# OPENAI_MODEL_SOAP=gpt-6.1-sol
# OPENAI_MODEL_CARE=gpt-6.1-sol
# OPENAI_MODEL_BRIEFING=gpt-6.1-sol

# Local persistence only. Vercel requires Supabase and refuses local storage.
# HANI_DATA_DIR=.hani-data
# DEMO_DEV_PIN=1234

# Kakao self-send. Every value stays server-only.
# KAKAO_APP_ID=1602111
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_TOKEN_ENCRYPTION_KEY=64_HEX_CHARACTERS
# APP_ORIGIN must exactly match the registered HTTPS deployment domain.

# Current-transcript clinical analysis; clinician reviews before saving.
# OPENAI_MODEL_ANALYSIS=gpt-6.1-sol

# 서버 텍스트 가림에 추가할 의료진 이름 (쉼표 구분, 선택)
HANI_PRIVACY_CLINICIAN_NAMES=
